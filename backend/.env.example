# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=           # Add your MySQL root password here (leave empty if no password)
DB_NAME=kundalini_db

# JWT Authentication
JWT_SECRET=            # Generate a random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d

# Gmail App Password (for sending verification/reset emails)
# Go to: https://myaccount.google.com/apppasswords
EMAIL_USER=            # Your Gmail address (e.g., yourname@gmail.com)
EMAIL_PASS=            # 16-character app password (no spaces)

# Google Gemini API Key (for AI chatbot)
# Go to: https://aistudio.google.com/apikey
GEMINI_API_KEY=        # Paste your Gemini API key here

# Frontend URL
CLIENT_URL=http://localhost:5173
PORT=3000
